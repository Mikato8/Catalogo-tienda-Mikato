PORT=4000
# Cadena de conexión que te da Neon (projects -> Connect)
DATABASE_URL=postgresql://usuario:clave@ep-host-pooler.c-region.aws.neon.tech/neondb?sslmode=require
# Secret para firmar los JWT de la aplicación (cámbiala en producción)
JWT_SECRET=una-clave-larga-y-secreta
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Logging (opcional): directorio y nivel para el archivo de log
LOG_DIR=./logs
LOG_LEVEL=info